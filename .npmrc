# Peer deps of transitive packages (e.g. the Claude Agent SDK's zod/@anthropic-ai/sdk
# peers) are installed automatically rather than failing the install.
auto-install-peers=true
strict-peer-dependencies=false

# Keep node_modules isolated. Nothing in this repo may rely on hoisting; every
# package must declare what it imports. This is what keeps `@rx-apollo/core` honest
# about never importing electron.
node-linker=isolated
shamefully-hoist=false

# Electron downloads its binary from a mirror during postinstall.
# Uncomment and point at an internal mirror if you are behind a proxy.
# electron_mirror=https://npmmirror.com/mirrors/electron/
