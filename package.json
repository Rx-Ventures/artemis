{
  "name": "rx-artemis",
  "version": "0.3.0",
  "private": true,
  "description": "Artemis — a desktop UI for agentic coding CLIs.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm run build:libs && pnpm --filter @rx-artemis/desktop dev",
    "build": "pnpm run build:libs && pnpm --filter @rx-artemis/desktop build",
    "build:libs": "tsc -b packages/protocol packages/core",
    "typecheck": "tsc -b --pretty",
    "typecheck:clean": "tsc -b --clean && tsc -b --pretty",
    "smoke": "pnpm run build:libs && tsx scripts/smoke.ts",
    "release": "tsx scripts/release.ts",
    "verify:package": "tsx scripts/verify-package.ts",
    "test": "pnpm -r --if-present test",
    "test:watch": "pnpm -r --if-present --parallel test:watch",
    "clean": "tsc -b --clean && rimraf --glob \"**/dist\" \"**/out\" \"**/.tsbuild\" \"**/*.tsbuildinfo\""
  },
  "devDependencies": {
    "@rx-artemis/core": "workspace:*",
    "@rx-artemis/protocol": "workspace:*",
    "@types/node": "^26.2.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  }
}
